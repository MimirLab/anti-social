+// Check resolved positional settings before touching attention or recurrent state.
+static std::vector<uint32_t> llama_position_state_recipe(const llama_model & model, const llama_cparams & cp, const std::vector<uint32_t> & cache) {
+    const auto & hp = model.hparams;
+    std::vector<uint32_t> words = {
+        0x4c535233, 1, uint32_t(model.arch), hp.n_embd, hp.n_layer_all, hp.n_layer_nextn,
+        cp.n_ctx, cp.n_ctx_seq, cp.n_seq_max, cp.n_rs_seq, uint32_t(cp.ctx_type),
+        uint32_t(cp.causal_attn), uint32_t(hp.rope_type), uint32_t(cp.rope_scaling_type), cp.n_ctx_orig_yarn,
+    };
+    auto floating = [&](float value) {
+        static_assert(sizeof(float) == sizeof(uint32_t), "Unexpected float representation");
+        uint32_t bits; std::memcpy(&bits, &value, sizeof(bits)); words.push_back(bits);
+    };
+    floating(cp.rope_freq_base); floating(cp.rope_freq_scale);
+    floating(cp.yarn_ext_factor); floating(cp.yarn_attn_factor);
+    floating(cp.yarn_beta_fast); floating(cp.yarn_beta_slow);
+    for (int section : hp.rope_sections) words.push_back(uint32_t(section));
+    for (uint32_t il = 0; il < hp.n_layer(); ++il) {
+        words.push_back(hp.n_rot(il)); words.push_back(hp.n_head(il)); words.push_back(hp.n_head_kv(il));
+        words.push_back(hp.n_embd_head_k(il)); words.push_back(hp.n_embd_head_v(il));
+        floating(model.get_rope_freq_base(cp, il)); floating(model.get_rope_freq_scale(cp, il));
+    }
+    words.insert(words.end(), cache.begin(), cache.end());
+    return words;
+}
+
+static void llama_write_position_state(llama_io_write_i & io, const llama_model & model, const llama_cparams & cp, const std::vector<uint32_t> & cache) {
+    const auto recipe = llama_position_state_recipe(model, cp, cache);
+    const uint32_t count = recipe.size();
+    io.write(&count, sizeof(count)); io.write(recipe.data(), recipe.size()*sizeof(uint32_t));
+}
+
+static void llama_read_position_state(llama_io_read_i & io, const llama_model & model, const llama_cparams & cp, const std::vector<uint32_t> & cache) {
+    const auto expected = llama_position_state_recipe(model, cp, cache);
+    uint32_t count; io.read(&count, sizeof(count));
+    if (count != expected.size()) throw std::runtime_error("Hybrid state positional recipe size mismatch");
+    std::vector<uint32_t> saved(expected.size());
+    io.read(saved.data(), saved.size()*sizeof(uint32_t));
+    if (saved != expected) throw std::runtime_error("Hybrid state positional recipe mismatch");
+}
