+            a1 = _mm_and_si128(_mm_srli_epi16(_mm_mullo_epi16(a1, mul), 6), three);
+            b0 = _mm_and_si128(_mm_srli_epi16(_mm_mullo_epi16(b0, mul), 6), three);
+            b1 = _mm_and_si128(_mm_srli_epi16(_mm_mullo_epi16(b1, mul), 6), three);
+            const __m128i codes0 = _mm_packus_epi16(a0, a1);
+            const __m128i codes1 = _mm_packus_epi16(b0, b1);
