+            ggml_backend_buffer_get_size(buf), initial, protected_ring);
+        ctxs_bufs.emplace_back(std::move(ctx), buf);
+    }
+}
+
+ggml_tensor * llama_kv_cache::protected_input(ggml_context * ctx, uint32_t count, bool indices) const {
+    if (!has_protected()) return nullptr;
+    auto * t = ggml_new_tensor_1d(ctx, indices ? GGML_TYPE_I64 : GGML_TYPE_I32, count);
+    ggml_set_input(t);
+    return t;
+}
+
+void llama_kv_cache::protected_set(ggml_tensor * indices, ggml_tensor * map, const llama_ubatch & ubatch, const slot_info & sinfo) const {
+    if (!has_protected()) return;
+    GGML_ASSERT(ubatch.n_tokens <= protected_ubatch && sinfo.n_stream() == 1);
+    auto * ids = static_cast<int64_t *>(indices->data);
+    const auto & cells = v_cells[0];
+    std::vector<bool> used(protected_positions.size(), false);
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        if (ubatch.n_seq_id[i] != 1 || ubatch.seq_id[i][0] != 0 || ubatch.pos[i] < 0)
+            throw std::runtime_error("Protected KV supports one explicit sequence");
+        const auto pos = ubatch.pos[i];
+        const auto cell = sinfo.idxs[0][i];
+        const uint32_t slot = uint32_t(pos) < protected_initial ? uint32_t(pos) : protected_initial + (uint32_t(pos) - protected_initial) % protected_ring;
+        if (used[slot]) throw std::runtime_error("Protected KV batch overwrites its own exact state");
+        used[slot] = true;
+        // Reuse of a physical cell must not leave an alias to old exact values.
+        for (size_t j = 0; j < protected_cells.size(); ++j)
+            if (protected_cells[j] == int32_t(cell)) protected_cells[j] = protected_positions[j] = -1;
+        protected_cells[slot] = int32_t(cell);
+        protected_positions[slot] = pos;
+        ids[i] = slot;
+    }
+    auto * lookup = static_cast<int32_t *>(map->data);
+    std::fill(lookup, lookup + map->ne[0], -1);
+    for (size_t j = 0; j < protected_cells.size(); ++j) {
+        const auto cell = protected_cells[j];
+        if (cell >= 0 && cell < map->ne[0] && !cells.is_empty(cell) && cells.pos_get(cell) == protected_positions[j])
+            lookup[cell] = int32_t(j);
+    }
+}
+
+ggml_tensor * llama_kv_cache::protected_get(ggml_context * ctx, int32_t il, bool value) const {
+    if (!has_protected()) return nullptr;
+    const auto & l = layers.at(map_layer_ids.at(il));
+    auto * t = value ? l.exact_v : l.exact_k;
+    const auto d = value ? hparams.n_embd_head_v(il) : hparams.n_embd_head_k(il);
+    const auto heads = hparams.n_head_kv(il);
+    // Same logical axes as flash attention: [D, slots, KV heads, streams].
+    return ggml_view_4d(ctx, t, d, t->ne[1], heads, 1, t->nb[1], d*sizeof(ggml_fp16_t), ggml_nbytes(t), 0);
+}
+
+ggml_tensor * llama_kv_cache::protected_store(ggml_context * ctx, ggml_tensor * current, ggml_tensor * indices, int32_t il, bool value) const {
+    const auto & l = layers.at(map_layer_ids.at(il));
+    auto * t = value ? l.exact_v : l.exact_k;
+    auto * rows = ggml_view_2d(ctx, current, current->ne[0]*current->ne[1], current->ne[2], current->nb[2], 0);
+    return ggml_set_rows(ctx, t, rows, indices);
+}
+
+void llama_kv_cache_context::protected_set(ggml_tensor * indices, ggml_tensor * map, const llama_ubatch & ubatch) const {
+    kv->protected_set(indices, map, ubatch, sinfos[i_cur]);
+}
+
+// The exact ring and its logical-position ownership are part of hybrid state,
+// never reconstructed by dequantizing history. A mismatched cache recipe fails.
+void llama_kv_cache::protected_write(llama_io_write_i & io) const {
+    const uint32_t header[] = {0x4c4b5632, protected_initial, protected_ring, protected_ubatch, rotation_kind};
+    io.write(header, sizeof(header));
+    io.write(&calibration_id, sizeof(calibration_id));
+    io.write(&basis_id, sizeof(basis_id));
+    if (!has_protected()) return;
+    io.write(protected_positions.data(), protected_positions.size()*sizeof(int32_t));
+    for (const auto & l : layers) {
+        io.write_tensor(l.exact_k, 0, ggml_nbytes(l.exact_k));
+        io.write_tensor(l.exact_v, 0, ggml_nbytes(l.exact_v));
+    }
+}
+
+void llama_kv_cache::protected_read(llama_io_read_i & io) {
+    uint32_t header[5]; io.read(header, sizeof(header));
+    uint64_t saved_calibration; io.read(&saved_calibration, sizeof(saved_calibration));
+    uint64_t saved_basis; io.read(&saved_basis, sizeof(saved_basis));
+    if (header[0] != 0x4c4b5632 || header[1] != protected_initial || header[2] != protected_ring || header[3] != protected_ubatch || header[4] != rotation_kind || saved_calibration != calibration_id || saved_basis != basis_id)
+        throw std::runtime_error("Protected KV state recipe mismatch");
+    if (!has_protected()) return;
+    io.read(protected_positions.data(), protected_positions.size()*sizeof(int32_t));
+    std::fill(protected_cells.begin(), protected_cells.end(), -1);
+    const auto & cells = v_cells[0];
+    for (size_t slot = 0; slot < protected_positions.size(); ++slot) {
+        const auto pos = protected_positions[slot];
+        if (pos < 0) continue;
+        const auto expected = uint32_t(pos) < protected_initial ? uint32_t(pos) : protected_initial + (uint32_t(pos) - protected_initial) % protected_ring;
+        if (expected != slot) throw std::runtime_error("Invalid protected KV position record");
+        for (uint32_t cell = 0; cell < cells.size(); ++cell)
+            if (!cells.is_empty(cell) && cells.pos_get(cell) == pos && cells.seq_has(cell, 0)) { protected_cells[slot] = cell; break; }
+    }
+    for (const auto & l : layers) {
+        io.read_tensor(l.exact_k, 0, ggml_nbytes(l.exact_k));
+        io.read_tensor(l.exact_v, 0, ggml_nbytes(l.exact_v));
+    }
+}
+
+ggml_tensor * llama_kv_cache::codec_scale_input(ggml_context * ctx) const {
+    if (channel_scales.empty()) return nullptr;
+    auto * t = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, channel_scales.size());
+    ggml_set_input(t); ggml_set_name(t, "antisocial_kv_channel_scale"); return t;
+}
+void llama_kv_cache::codec_scale_set(ggml_tensor * t) const {
+    GGML_ASSERT(ggml_backend_buffer_is_host(t->buffer) && t->ne[0] == int64_t(channel_scales.size()));
+    memcpy(t->data, channel_scales.data(), ggml_nbytes(t));
+}
+ggml_tensor * llama_kv_cache::inverse_v_input(ggml_context * ctx) const {
+    if (!rotation_kind) return nullptr;
+    auto * t = build_input_v_rot(ctx); ggml_set_name(t, "antisocial_kv_inverse_v"); return t;
+}
+void llama_kv_cache::inverse_v_set(ggml_tensor * t) const {
+    GGML_ASSERT(ggml_backend_buffer_is_host(t->buffer));
+    const auto & matrix = attn_rot_hadamard.at(t->ne[0]);
+    const auto inverse = llama_kv_inverse_rotation(matrix, t->ne[0]);
+    memcpy(t->data, inverse.data(), ggml_nbytes(t));
+}
