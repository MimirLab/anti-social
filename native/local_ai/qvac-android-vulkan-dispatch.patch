--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -79,6 +79,16 @@
 #include <future>
 #include <condition_variable>
 #include <thread>
+
+// Android API 26/27 loaders need instance dispatch for Vulkan 1.1 queries;
+// linking the global entry point would require Android API 28 at load time.
+static void ggml_vk_query_physical_features(VkPhysicalDevice device, VkPhysicalDeviceFeatures2 * features) {
+    auto query = ggml_vk_default_dispatcher().vkGetPhysicalDeviceFeatures2;
+    if (!query) {
+        throw std::runtime_error("Vulkan 1.1 physical-device queries are unavailable");
+    }
+    query(device, features);
+}
 
